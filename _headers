# En-têtes de sécurité — Cloudflare Workers (assets statiques).
# Ce fichier doit rester à la racine du dépôt, à côté de index.html.
# Il n'est pas servi au visiteur : Cloudflare le lit au déploiement.
#
# La page ne contient aucun JavaScript : script-src peut donc être fermé
# complètement, ce qui est la posture la plus stricte possible.

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=()
  Content-Security-Policy: default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; script-src 'none'; connect-src 'none'; object-src 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://www.squarian.com
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site
  X-Robots-Tag: noindex, nofollow
